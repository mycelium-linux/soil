; SPDX-License-Identifier: MIT OR Apache-2.0
; Soil Lisp prelude: generic list, JSON, records, and time helpers.
; Domain policy (devices, signals, profiles) belongs above this file.

(defun map (f xs)
  (if (nil? xs)
      nil
      (cons (apply f (list (first xs))) (map f (rest xs)))))

(defun filter (p xs)
  (cond
    ((nil? xs) nil)
    ((apply p (list (first xs))) (cons (first xs) (filter p (rest xs))))
    (else (filter p (rest xs)))))

(defun any? (p xs)
  (if (nil? xs)
      #f
      (if (apply p (list (first xs)))
          #t
          (any? p (rest xs)))))

(defun all? (p xs)
  (if (nil? xs)
      #t
      (if (apply p (list (first xs)))
          (all? p (rest xs))
          #f)))

(defun find (p xs)
  (cond
    ((nil? xs) nil)
    ((apply p (list (first xs))) (first xs))
    (else (find p (rest xs)))))

(defun take (n xs)
  (if (or (<= n 0) (nil? xs))
      nil
      (cons (first xs) (take (- n 1) (rest xs)))))

(defun drop (n xs)
  (if (or (<= n 0) (nil? xs))
      xs
      (drop (- n 1) (rest xs))))

(defun reverse-into (xs out)
  (if (nil? xs)
      out
      (reverse-into (rest xs) (cons (first xs) out))))

(defun reverse (xs)
  (reverse-into xs nil))

;;; Generic list helpers used by UI examples and spores.

(defun nth (n xs)
  (cond
    ((nil? xs) nil)
    ((<= n 0) (first xs))
    (else (nth (- n 1) (rest xs)))))

(defun list-set (n value xs)
  (cond
    ((nil? xs) nil)
    ((<= n 0) (cons value (rest xs)))
    (else (cons (first xs) (list-set (- n 1) value (rest xs))))))

(defun range-into (i end out)
  (if (>= i end)
      (reverse out)
      (range-into (+ i 1) end (cons i out))))

(defun range (start end)
  (range-into start end nil))

(defun map-with (f arg xs)
  (if (nil? xs)
      nil
      (cons (apply f (list (first xs) arg)) (map-with f arg (rest xs)))))

(defun filter-with (p arg xs)
  (cond
    ((nil? xs) nil)
    ((apply p (list (first xs) arg)) (cons (first xs) (filter-with p arg (rest xs))))
    (else (filter-with p arg (rest xs)))))

(defun take-while (pred xs)
  (if (nil? xs)
      nil
      (if (apply pred (list (first xs)))
          (cons (first xs) (take-while pred (rest xs)))
          nil)))

(defun drop-while (pred xs)
  (cond
    ((nil? xs) nil)
    ((apply pred (list (first xs))) (drop-while pred (rest xs)))
    (else xs)))

(defun last-of (xs)
  (if (nil? (rest xs))
      (first xs)
      (last-of (rest xs))))

(defun reduce (f acc xs)
  (if (nil? xs)
      acc
      (reduce f (apply f (list acc (first xs))) (rest xs))))

(defun assoc (key value record)
  (if (nil? record)
      nil
      (let ((pair (first record)))
        (if (= (first pair) key)
            (cons (list key value) (rest record))
            (cons pair (assoc key value (rest record)))))))

(defun json-get (value key)
  (field value key))

(defun json-get-in (value keys)
  (if (nil? keys)
      value
      (json-get-in (field value (first keys)) (rest keys))))

(defun page-entries (page)
  (field page :entries))

(defun entry-key (entry)
  (field entry :key))

(defun entry-id (entry)
  (field (entry-key entry) :id))

(defun entry-collection (entry)
  (field (entry-key entry) :collection))

(defun entry-schema (entry)
  (field entry :schema))

(defun entry-updated-at (entry)
  (field entry :updated-at-ms))

(defun entry-body (entry)
  (json-decode (field entry :body)))

(defun record-key (collection id)
  (list (list :collection collection) (list :id id)))

(defun make-entry (collection id schema body now)
  (list
    (list :key (record-key collection id))
    (list :schema schema)
    (list :revision 0)
    (list :updated-at-ms now)
    (list :origin "soil")
    (list :deleted #f)
    (list :body (json-encode body))))

(defun upsert-record (collection id schema body now)
  (soil:records/upsert (make-entry collection id schema body now)))

(defun now-ms ()
  (field (value (soil:time/wall-clock)) :unix-ms))

; McCarthy-style accessors.
(defun caar (x) (car (car x)))
(defun cadr (x) (car (cdr x)))
(defun cdar (x) (cdr (car x)))
(defun caddr (x) (car (cdr (cdr x))))
(defun cadar (x) (car (cdr (car x))))
(defun caddar (x) (car (cdr (cdr (car x)))))
