(defun inc (n) (+ n 1))
(defun even? (n) (or (= n 2) (= n 4)))
(defun over-two? (n) (> n 2))

(defun test/map ()
  (= (map (quote inc) (list 1 2 3)) (list 2 3 4)))

(defun test/filter ()
  (= (filter (quote even?) (list 1 2 3 4)) (list 2 4)))

(defun test/any ()
  (any? (quote over-two?) (list 1 2 3)))

(defun under-three? (n) (< n 3))

(defun test/take-while ()
  (= (take-while 'under-three? (list 1 2 3 1)) (list 1 2)))

(defun test/drop-while ()
  (= (drop-while 'under-three? (list 1 2 3 1)) (list 3 1)))

(defun test/last-of ()
  (= (last-of (list 1 2 3)) 3))
